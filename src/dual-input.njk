---
layout: layouts/base.njk
title: Dual Input
permalink: /dual-input/
---
<div id="top"></div>
<div class ="topbar">
    <div class="topbarleft">
        <a href="#top" class="topbarbutton topbartext">
            {{ text.topbar.left | default("DUAL INPUT") }}
        </a>
    </div>

    <div class="topbarcenter">
    </div> 

    <div class="topbarright" id="topbarRight">
     <a href="https://id24.com/" class="topbarbutton topbartext company-link" data-cursor-label="Go to company website">
            {{ text.topbar.right | default("ID24 Technology") }}
     </a>
    </div>
</div>

<header class="tagline"> 
    <p class="header"> {{ text.tagline.tag }} </p>
</header>


<main>
<div class="screen-animation"> 
    <div class="dual-screens">
        <div class="left-screen">
            <div class="input-screen"> 
                <div class="screen-text" id="sharedOutputLeft"> </div>
            </div>
            <div class="keys">
                    <button class="screen-button" data-key="D">D</button>
                    <button class="screen-button" data-key="U">U</button>
                    <button class="screen-button" data-key="A">A</button>
                    <button class="screen-button" data-key="L">L</button>

                    <button class="screen-button key-wide" data-key="BACKSPACE">⌫</button>

                    <button class="screen-button" data-key="I">I</button>
                    <button class="screen-button" data-key="N">N</button>
                    <button class="screen-button" data-key="P">P</button>
                    <button class="screen-button" data-key="U">U</button>
                    <button class="screen-button" data-key="T">T</button>

                    <button class ="screen-button key-blancspace" data-key=" "> </button>

            </div>
        </div>

        <div class="right-screen">
            <div class="input-screen"> 
                <div class="screen-text" id="sharedOutputRight"> </div>
            </div>
            <div class="keys"> 
                <button class="screen-button" data-key="D">D</button>
                <button class="screen-button" data-key="U">U</button>
                <button class="screen-button" data-key="A">A</button>
                <button class="screen-button" data-key="L">L</button>
                    
                <button class="screen-button key-wide" data-key="BACKSPACE">⌫</button>

                <button class="screen-button" data-key="I">I</button>
                <button class="screen-button" data-key="N">N</button>
                <button class="screen-button" data-key="P">P</button>
                <button class="screen-button" data-key="U">U</button>
                <button class="screen-button" data-key="T">T</button>

                <button class ="screen-button key-blancspace" data-key=" "> </button>
            </div>
        </div>

    </div>
</div>

<!---
<div class ="tagline-first">
    <p class="tagline">
        <span class="typing-line">
            {{ text.tagline.tag }}
        </span><br>

        <span class="mirrored">
            <span class="typing-line">
                {{ text.tagline.tag }}
             </span> 
        </span>
    </p>
</div>
-->

<div class ="info-grid">
    <div class ="info-box-1">
        <p class="info-text-header typing-line"> {{ text["info-1"].title }} </p>
        <p class="info-text"> {{ text["info-1"].paragraph1 }} </p>
        <p class="info-text"> {{ text["info-1"].paragraph2 }} </p>
        <p class="info-text"> {{ text["info-1"].paragraph3 }} </p>
    </div>

    <div class ="info-animation-1">
        <div class ="animation-built1used2">
            <div class="built1used2-laptop"></div>
            <div class="built1used2-screen"></div>
            <div class="built1used2-cursor1"></div>
            <div class="built1used2-cursor2"></div>
        </div>
    </div>

    <div class ="info-box-2">
        <p class="info-text-header"> {{ text["info-2"].title }} </p>
        <p class="info-text"> {{ text["info-2"].paragraph1 }} </p>
        <p class="info-text"> {{ text["info-2"].paragraph2 }} </p>
        <p class="info-text"> {{ text["info-2"].paragraph3 }} </p>
    </div>

    <div class = "info-animation-2">
        <div class ="animation-ownSession">
            <div class="ownSession-laptop"></div>
            <div class="ownSession-screen"></div>
            <div class="ownSession-cursor1"></div>
            <div class="ownSession-cursor2"></div>
        </div> 
    </div>

    <div class ="info-box-3">
        <p class="info-text-header">{{ text["info-3"].title }}</p>
        <p class="info-text"> {{ text["info-3"].paragraph1 }} </p>
        <p class="info-text"> {{ text["info-3"].paragraph2 }} </p>
        <p class="info-text"> {{ text["info-3"].paragraph3 }} </p>
    </div>

    <div class = "info-animation-3">
        <div class ="animation-company">
            <a href="https://id24.com/" class="screen-button-link" aria-label="Go to ID24 website">
                {{ text.companylink | default("ID24") }}
            </a>
            <p class="company-link-label">Click to visit ID24 website</p>
        </div> 
    </div>

</div>
</main>


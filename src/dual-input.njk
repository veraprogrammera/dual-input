---
layout: layouts/base.njk
title: Duo Input
permalink: /dual-input/
---
<div id="top"></div>
<div class ="topbar">
    <div class="topbarleft">
        <a href="/dual-input/" class="topbarbutton topbartext">
            {{ text.topbar.left | default("DUO INPUT") }}
        </a>
        <nav class="topbar-scroll-nav" aria-label="Duo Input page navigation">
            <a href="/dual-input/use-cases/" class="topbarbutton topbartext">For businesses</a>
            <a href="/dual-input/technical/" class="topbarbutton topbartext">Technical details</a>
        </nav>
    </div>

    <div class="topbarcenter">
    </div> 

    <div class="topbarright" id="topbarRight">
     <a href="https://id24.com/" class="topbarbutton topbartext company-link" data-cursor-label="Go to company website">
            {{ text.topbar.right | default("ID24 Technology") }}
     </a>
    </div>
</div>

<header class="tagline"> 
    <p class="header"> {{ text.tagline.tag }} </p>
</header>


<main>
<div class="screen-animation"> 
    <div class="dual-screens">
        <div class="left-screen">
            <div class="input-screen"> 
                <div class="screen-text" id="sharedOutputLeft"> </div>
            </div>
            <div class="keys">
                    <button class="screen-button" data-key="D">D</button>
                    <button class="screen-button" data-key="U">U</button>
                    <button class="screen-button" data-key="O">O</button>

                    <button class="screen-button key-wide" data-key="BACKSPACE">⌫</button>

                    <button class="screen-button" data-key="I">I</button>
                    <button class="screen-button" data-key="N">N</button>
                    <button class="screen-button" data-key="P">P</button>
                    <button class="screen-button" data-key="U">U</button>
                    <button class="screen-button" data-key="T">T</button>

                    <button class ="screen-button key-blancspace" data-key=" "> </button>
            </div>
        </div>

        <div class="right-screen">
            <div class="input-screen"> 
                <div class="screen-text" id="sharedOutputRight"> </div>
            </div>
            <div class="keys"> 
                <button class="screen-button" data-key="D">D</button>
                <button class="screen-button" data-key="U">U</button>
                <button class="screen-button" data-key="O">O</button>
                    
                <button class="screen-button key-wide" data-key="BACKSPACE">⌫</button>

                <button class="screen-button" data-key="I">I</button>
                <button class="screen-button" data-key="N">N</button>
                <button class="screen-button" data-key="P">P</button>
                <button class="screen-button" data-key="U">U</button>
                <button class="screen-button" data-key="T">T</button>

                <button class ="screen-button key-blancspace" data-key=" "> </button>
            </div>
        </div>

    </div>
</div>

<section class="use-cases-link-section" aria-labelledby="use-cases-link-heading">
    <p class="eyebrow-text">Two screens. Two users. One seamless experience.</p>
    <h2 class="use-cases-link-heading" id="use-cases-link-heading">Duo Input in real setups</h2>
    <p class="use-cases-link-copy">
        See how simultaneous input supports forms, data entry, digital signatures and customer-facing displays.
    </p>
    <a class="primary-text-button" href="/dual-input/use-cases/">For businesses</a>
</section>

<!---

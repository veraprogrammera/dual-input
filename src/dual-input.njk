<div class ="footer-grid">
        <div class="footer-left">
            <p class="footer-text">
            {{ text.footer | default("© 2026 ID24 Technology") }}
            </p>
            <p class="footer-subtext">
            Duo Input technology for shared systems, independent touch and multi-screen interaction.
            </p>
        </div>
        <div class="footer-right">
            <h2 class="footer-heading">Contact us</h2>
            <p class="footer-subtext footer-contact">
            Ready for demos, integrations and partnerships.
            </p>
            <p class="footer-subtext footer-contact-links">
                <a href="mailto:sales@id24.com">sales@id24.com</a>
                <a href="https://www.id24.com/">www.id24.com</a>
            </p>
        </div>
</div>
